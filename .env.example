# Resend — https://resend.com/api-keys
RESEND_API_KEY=your-resend-key

# Verified sender on your Resend domain. Falls back to Resend's shared test sender.
CONTACT_FROM_EMAIL="New Enquiry <onboarding@resend.dev>"

# Where enquiries are delivered. Defaults to the address in lib/data.ts.
CONTACT_TO_EMAIL=your-email

# Public site origin — used for canonical URLs, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL=your-domain
